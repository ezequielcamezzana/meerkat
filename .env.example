# meerkat server configuration (copy to .env, fill in, never commit .env).
# All variables are optional unless noted.

# --- Core ---
MEERKAT_LISTEN=:8080
MEERKAT_DB_PATH=/var/lib/meerkat/meerkat.db
MEERKAT_BASE_URL=https://meerkat.example.com
MEERKAT_LOG_LEVEL=info
MEERKAT_CORS_ALLOWED_ORIGINS=*

# --- Email alerts (optional; Brevo takes precedence over SMTP) ---
# MEERKAT_BREVO_API_KEY=xkeysib-...
# MEERKAT_NOTIFY_FROM=alerts@example.com   # must be a Brevo-verified sender
# MEERKAT_NOTIFY_FROM_NAME=meerkat
# SMTP fallback (used only when MEERKAT_BREVO_API_KEY is unset):
# MEERKAT_SMTP_HOST=
# MEERKAT_SMTP_PORT=587
# MEERKAT_SMTP_USER=
# MEERKAT_SMTP_PASS=

# --- Passive scanning ---
MEERKAT_REMATCH_INTERVAL=1h
MEERKAT_REMATCH_BATCH=100
